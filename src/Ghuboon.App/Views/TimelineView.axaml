<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ghuboon.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="Ghuboon.App.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">

    <Design.DataContext>
        <vm:TimelineViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Column header -->
        <Border Grid.Row="0"
                Padding="8,6"
                BorderThickness="0,0,0,1"
                BorderBrush="#22000000"
                Background="#06000000">
            <Grid ColumnDefinitions="14,96,220,120,*,28,64">
                <TextBlock Grid.Column="0" Text="" />
                <TextBlock Grid.Column="1" Text="Reason"     FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="Repository" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="6,0,0,0" />
                <TextBlock Grid.Column="3" Text="User"       FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="6,0,0,0" />
                <TextBlock Grid.Column="4" Text="Title"      FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="6,0,0,0" />
                <TextBlock Grid.Column="5" Text="Open"       FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="Updated"    FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   Text="No notifications match the current filter."
                   FontSize="13"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}" />

        <ListBox Grid.Row="1"
                 x:Name="ItemsList"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 SelectionChanged="OnSelectionChanged"
                 IsVisible="{Binding !IsEmpty}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:TimelineItemViewModel">
                    <Border Padding="0"
                            Background="Transparent"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#11000000">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy event id" Command="{Binding CopyEventIdCommand}" />
                                <MenuItem Header="Copy URL"      Command="{Binding CopyUrlCommand}" />
                                <Separator />
                                <MenuItem Header="Open in GitHub" Command="{Binding OpenInGitHubCommand}" />
                                <MenuItem Header="Mark as read"   Command="{Binding MarkAsReadCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <!-- Single-row layout: unread / reason / repo / title / time -->
                            <Grid ColumnDefinitions="14,96,220,120,*,28,64"
                                  VerticalAlignment="Center"
                                  Margin="8,4">
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Fill="DodgerBlue"
                                         IsVisible="{Binding Unread}" />

                                <Border Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Padding="6,1"
                                        CornerRadius="3"
                                        Background="{Binding KindBadgeColor}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindBadgeText}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding RepositoryFullName}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding DisplayUserLogin, StringFormat='@{0}'}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Title}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.85"
                                           TextTrimming="CharacterEllipsis"
                                           Cursor="Hand"
                                           DoubleTapped="OnTitleDoubleTapped" />

                                <Button Grid.Column="5"
                                        Command="{Binding OpenInGitHubCommand}"
                                        ToolTip.Tip="Open on GitHub.com"
                                        AutomationProperties.Name="Open on GitHub"
                                        Padding="4,1"
                                        MinHeight="22"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <TextBlock Text="&#x2197;"
                                               FontSize="14"
                                               Opacity="0.7" />
                                </Button>

                                <TextBlock Grid.Column="6"
                                           Text="{Binding RelativeTime}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Opacity="0.6"
                                           FontSize="11" />
                            </Grid>

                            <!-- Expanded actions (kept off the main row) -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="116,0,8,6"
                                        IsVisible="{Binding IsExpanded}">
                                <Button Content="Open in GitHub"
                                        Command="{Binding OpenInGitHubCommand}"
                                        Padding="8,3" />
                                <Button Content="Mark as read"
                                        Command="{Binding MarkAsReadCommand}"
                                        Padding="8,3" />
                                <Button Content="Copy URL"
                                        Command="{Binding CopyUrlCommand}"
                                        Padding="8,3" />
                            </StackPanel>

                            <TextBlock Text="{Binding FlashMessage}"
                                       Margin="116,0,8,4"
                                       FontSize="11"
                                       Opacity="0.7"
                                       IsVisible="{Binding FlashMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
