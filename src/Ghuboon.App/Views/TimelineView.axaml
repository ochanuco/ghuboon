<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ghuboon.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="Ghuboon.App.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">

    <Design.DataContext>
        <vm:TimelineViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Margin="12,8"
                   FontSize="12"
                   Opacity="0.7"
                   Text="{Binding CurrentFilter, StringFormat='Filter: {0}'}" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:TimelineItemViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="4,6">
                        <Ellipse Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                 Width="8" Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="DodgerBlue"
                                 IsVisible="{Binding Unread}" />

                        <Border Grid.Column="1" Grid.Row="0"
                                Margin="0,0,8,0"
                                Padding="6,2"
                                CornerRadius="3"
                                Background="#1F6FEB">
                            <TextBlock Text="{Binding Reason}"
                                       Foreground="White"
                                       FontSize="11" />
                        </Border>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="{Binding RepositoryFullName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="3" Grid.Row="0"
                                   Text="{Binding UpdatedRelative}"
                                   Opacity="0.6"
                                   FontSize="11"
                                   Margin="8,0,0,0" />

                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="{Binding Title}"
                                   Margin="0,2,0,0"
                                   Opacity="0.85"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
