<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ghuboon.App.ViewModels"
        xmlns:views="using:Ghuboon.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Ghuboon.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Ghuboon"
        Width="900" Height="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top bar -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#33000000">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Content="Sync"
                        Command="{Binding SyncCommand}"
                        IsEnabled="{Binding !IsSyncing}" />

                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           Text="{Binding UnreadCount, StringFormat='Unread: {0}'}" />

                <ComboBox Grid.Column="3"
                          Margin="12,0,0,0"
                          PlaceholderText="All repos"
                          ItemsSource="{Binding Repositories}"
                          SelectedValue="{Binding SelectedRepositoryFullName}"
                          SelectedValueBinding="{Binding FullName}"
                          MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="4"
                         Margin="12,0"
                         PlaceholderText="Search"
                         Text="{Binding SearchText}" />

                <Button Grid.Column="5"
                        Content="Settings"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <!-- Tabs -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab}"
                 Padding="8,4"
                 BorderThickness="0,0,0,1"
                 BorderBrush="#22000000"
                 Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="10,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Body: timeline or settings -->
        <Panel Grid.Row="2">
            <ContentControl IsVisible="{Binding !IsSettingsVisible}"
                            Content="{Binding Timeline}" />
            <ContentControl IsVisible="{Binding IsSettingsVisible}"
                            Content="{Binding Settings}" />
        </Panel>

        <!-- Status bar (Phase 14) -->
        <Border Grid.Row="3"
                Padding="10,4"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000"
                Background="#06000000">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding LastSyncText}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           IsVisible="{Binding LastSyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding UnreadCount, StringFormat='{}{0} unread'}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.7" />

                <TextBlock Grid.Column="4"
                           Text="{Binding RateLimitText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           IsVisible="{Binding RateLimitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Grid.Column="5"
                           Text="{Binding ErrorMessage}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#CF222E"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="8,0,0,0"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Button Content="Retry"
                            Padding="6,1"
                            FontSize="11"
                            Command="{Binding RetrySyncCommand}" />
                    <Button Content="Dismiss"
                            Padding="6,1"
                            FontSize="11"
                            Command="{Binding DismissErrorCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
