<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ghuboon.App.ViewModels"
        xmlns:views="using:Ghuboon.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Ghuboon.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Ghuboon"
        Width="900" Height="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0 top bar -->
            <RowDefinition Height="*" />      <!-- 1 timeline -->
            <RowDefinition Height="Auto" />   <!-- 2 tabs -->
            <RowDefinition Height="Auto" />   <!-- 3 splitter -->
            <RowDefinition Height="160" MinHeight="60" /> <!-- 4 detail (resizable) -->
            <RowDefinition Height="Auto" />   <!-- 5 status -->
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#33000000">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Content="Sync"
                        Command="{Binding SyncCommand}"
                        IsEnabled="{Binding !IsSyncing}" />

                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           Text="{Binding UnreadCount, StringFormat='Unread: {0}'}" />

                <ComboBox Grid.Column="3"
                          Margin="12,0,0,0"
                          PlaceholderText="All repos"
                          ItemsSource="{Binding Repositories}"
                          SelectedValue="{Binding SelectedRepositoryFullName}"
                          SelectedValueBinding="{Binding FullName}"
                          MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="4"
                         Margin="12,0"
                         PlaceholderText="Search"
                         Text="{Binding SearchText}" />

                <Button Grid.Column="5"
                        Content="{Binding SettingsToggleLabel}"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <!-- Body: timeline (or full-window settings) -->
        <Panel Grid.Row="1">
            <ContentControl IsVisible="{Binding !IsSettingsVisible}"
                            Content="{Binding Timeline}" />
        </Panel>

        <!-- Tabs (sit just below the timeline, Tween-style) -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab}"
                 Padding="8,4"
                 BorderThickness="0,1,0,0"
                 BorderBrush="#22000000"
                 Background="Transparent"
                 IsVisible="{Binding !IsSettingsVisible}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="10,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Splitter to resize the detail pane -->
        <GridSplitter Grid.Row="3"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Background="#11000000"
                      IsVisible="{Binding !IsSettingsVisible}" />

        <!-- Detail panel: title + body, action buttons bottom-right -->
        <Border Grid.Row="4"
                Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000"
                Background="#04000000"
                IsVisible="{Binding !IsSettingsVisible}">
            <Grid DataContext="{Binding Timeline.SelectedItem}"
                  RowDefinitions="Auto,*,Auto">
                <!-- Header: reason badge / repo / relative time -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0"
                            Padding="6,1"
                            CornerRadius="3"
                            Background="{Binding ReasonBadgeColor, FallbackValue=#22000000}"
                            IsVisible="{Binding ReasonBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ReasonBadgeText}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{Binding RepositoryFullName, FallbackValue=''}" />
                    <TextBlock Grid.Column="3"
                               Opacity="0.7"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Text="{Binding RelativeTime, FallbackValue=''}" />
                </Grid>

                <!-- Title + body (scrollable) -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,4,0,4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title, FallbackValue='Select a row to see details.'}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Loading description…"
                                   FontSize="12"
                                   Opacity="0.6"
                                   FontStyle="Italic"
                                   IsVisible="{Binding IsLoadingBody, FallbackValue=False}" />
                        <TextBlock Text="{Binding Body, FallbackValue=''}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Body, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                        <TextBlock Text="(no description / unsupported subject)"
                                   FontSize="12"
                                   Opacity="0.5"
                                   FontStyle="Italic"
                                   IsVisible="{Binding HasNoBodyAfterLoad, FallbackValue=False}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom-right action buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding NotificationId, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                    <Button Content="Open in GitHub"
                            Command="{Binding OpenInGitHubCommand}"
                            Padding="8,2" />
                    <Button Content="Mark as read"
                            Command="{Binding MarkAsReadCommand}"
                            Padding="8,2" />
                    <Button Content="Copy URL"
                            Command="{Binding CopyUrlCommand}"
                            Padding="8,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar (Phase 14) -->
        <Border Grid.Row="5"
                Padding="10,4"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000"
                Background="#06000000">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding LastSyncText}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           IsVisible="{Binding LastSyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding UnreadCount, StringFormat='{}{0} unread'}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.7" />

                <TextBlock Grid.Column="4"
                           Text="{Binding RateLimitText}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           IsVisible="{Binding RateLimitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Grid.Column="5"
                           Text="{Binding ErrorMessage}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#CF222E"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="8,0,0,0"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Button Content="Retry"
                            Padding="6,1"
                            FontSize="11"
                            Command="{Binding RetrySyncCommand}" />
                    <Button Content="Dismiss"
                            Padding="6,1"
                            FontSize="11"
                            Command="{Binding DismissErrorCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings full-window overlay -->
        <ContentControl Grid.Row="1" Grid.RowSpan="5"
                        IsVisible="{Binding IsSettingsVisible}"
                        Content="{Binding Settings}" />
    </Grid>
</Window>
