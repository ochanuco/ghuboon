<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ghuboon.App.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="120"
             x:Class="Ghuboon.App.Views.Settings.AboutSettingsView"
             x:DataType="vm:AboutSettingsViewModel">

    <StackPanel Spacing="6">
        <TextBlock Text="About" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Text="Ghuboon" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Opacity="0.8" />
        <Button Content="{Binding RepositoryDisplay, StringFormat='Open {0}'}"
                Command="{Binding OpenRepositoryCommand}"
                HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
